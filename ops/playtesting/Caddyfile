{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip
	@railwayClient expression `"{$PLAYMAT_RAILWAY_INGRESS:false}" == "true" && {http.request.header.X-Real-IP} != ""`
	@railway expression `"{$PLAYMAT_RAILWAY_INGRESS:false}" == "true"`
	header @railway Strict-Transport-Security "max-age=31536000"
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}

	route {
		@publicPlayerSelector header X-Playmat-Player-Id *
		respond @publicPlayerSelector 403
		request_header -X-Playmat-Human-Table
		request_header -X-Playmat-Canonical-Agent
		request_header -X-Playmat-User
		request_header -X-Playmat-Account
		request_header -X-Playmat-Seat
		request_header -X-Playmat-Connection
		request_header -X-Playmat-Rate-Exempt
		request_header X-Playmat-Client-IP {remote_host}
		request_header @railwayClient X-Playmat-Client-IP {http.request.header.X-Real-IP}

		handle /healthz {
			forward_auth 127.0.0.1:8790 {
				uri /healthz
			}
			reverse_proxy 127.0.0.1:17173
		}

		handle /ws {
			forward_auth 127.0.0.1:8790 {
				uri /internal/verify?scope=play
				copy_headers X-Playmat-Canonical-Agent X-Playmat-User X-Playmat-Account X-Playmat-Seat X-Playmat-Connection X-Playmat-Rate-Exempt
			}
			reverse_proxy 127.0.0.1:17172 {
				header_up X-Forwarded-For {http.request.header.X-Playmat-Client-IP}
				header_up X-Real-IP {http.request.header.X-Playmat-Client-IP}
				# Railway exempts WebSockets from its 15-minute HTTP limit. A short cut here
				# dropped live games every 15 minutes; this only bounds a revoked session.
				stream_timeout 12h
			}
		}

		handle /mcp {
			request_body {
				max_size 1MB
			}
			reverse_proxy 127.0.0.1:8791
		}

		@product path /login /logout /api/playtesting/* /oauth/authorize /oauth/token /oauth/register /oauth/revoke /oauth/connections /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp
		handle @product {
			request_body {
				max_size 320KB
			}
			reverse_proxy 127.0.0.1:8790
		}

		handle /internal/* {
			respond 404
		}

		@publicPages path / /register /register/ /register/complete /register/complete/ /index.html /watch/* /join/mcp/* /tournaments /tournaments/* /statistics /statistics/
		handle @publicPages {
			header Referrer-Policy no-referrer
			header Cache-Control no-cache
			root * /srv/playmat
			rewrite * /index.html
			file_server
		}

		@publicAssets path /assets/* /sw.js /favicon.svg /robots.txt /manifest.webmanifest /apple-touch-icon.png /icon-192.png /icon-512.png /icon-maskable-512.png
		handle @publicAssets {
			root * /srv/playmat
			file_server
		}

		handle {
			route {
				forward_auth 127.0.0.1:8790 {
					uri /internal/verify?redirect=1
				}
				root * /srv/playmat
				try_files {path} /index.html
				file_server
			}
		}
	}
}
